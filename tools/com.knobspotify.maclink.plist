<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.knobspotify.maclink</string>
  <key>ProgramArguments</key>
  <array>
    <!-- /usr/bin/python3 deliberately, not a Homebrew python: this must keep
         working after a brew upgrade removes or moves the interpreter. The
         helper is stdlib-only for the same reason. -->
    <string>/usr/bin/python3</string>
    <string>REPLACE_WITH_ABSOLUTE_PATH/tools/mac_link.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- IP FIRST, name as the fallback - the reverse burned us. The ESP32's
         mDNS answers so slowly that every resolve costs ~5.4 seconds, and
         because it eventually SUCCEEDS it never errors, never rotates, and
         silently taxes every single beat: commands that should deliver in
         ~150ms delivered every 5.5s, measured end to end with timestamps on
         both sides. The name stays as the fallback so a DHCP lease moving
         degrades to slow instead of dead - and the log says which host is in
         use either way. -->
    <key>KNOB_HOST</key>
    <string>REPLACE_WITH_DEVICE_IP,knobspotify.local</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/knob-maclink.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/knob-maclink.log</string>
</dict>
</plist>
